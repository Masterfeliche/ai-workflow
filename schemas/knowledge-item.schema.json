{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Knowledge Record",
  "type": "object",
  "required": ["id", "type", "scope", "title", "summary", "content", "version", "status", "provenance", "sources", "access"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "type": {"enum": ["concept", "pattern", "decision", "domain_rule", "code_reference", "troubleshooting", "learning"]},
    "scope": {"enum": ["global", "project", "repository", "feature", "sprint", "learning"]},
    "project_id": {"type": ["string", "null"]},
    "repository": {"type": ["string", "null"]},
    "title": {"type": "string", "minLength": 3},
    "summary": {"type": "string", "minLength": 1},
    "content": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "under_review", "approved", "deprecated", "superseded"]},
    "confidence": {"enum": ["confirmed", "strongly_inferred", "proposed", "uncertain"]},
    "provenance": {"type": "object", "required": ["source_type", "captured_at"], "properties": {
      "source_type": {"enum": ["source_code", "test", "adr", "edd", "requirement", "sprint_learning", "reviewed_reference", "human_observation"]},
      "captured_at": {"type": "string"},
      "captured_by": {"type": ["string", "null"]},
      "content_hash": {"type": ["string", "null"]}
    }, "additionalProperties": true},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["uri", "source_type"], "properties": {
      "uri": {"type": "string", "minLength": 1},
      "source_type": {"type": "string"},
      "revision": {"type": ["string", "null"]},
      "symbol": {"type": ["string", "null"]}
    }, "additionalProperties": true}},
    "relationships": {"type": "array", "items": {"type": "object"}},
    "access": {"type": "object", "required": ["visibility"], "properties": {
      "visibility": {"enum": ["global", "project", "repository", "restricted"]},
      "tenant_id": {"type": ["string", "null"]},
      "classification": {"type": ["string", "null"]}
    }, "additionalProperties": false},
    "review": {"type": ["object", "null"], "properties": {
      "reviewed_by": {"type": ["string", "null"]},
      "reviewed_at": {"type": ["string", "null"]},
      "decision": {"type": ["string", "null"]},
      "notes": {"type": ["string", "null"]}
    }, "additionalProperties": true},
    "supersedes": {"type": ["string", "null"]},
    "superseded_by": {"type": ["string", "null"]},
    "created_at": {"type": ["string", "null"]},
    "updated_at": {"type": ["string", "null"]}
  }
}
